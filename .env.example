SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Institution details shown across the site.
COLLEGE_NAME=Nayolites Compute and Media College
COLLEGE_SHORT_NAME=Nayolites
COLLEGE_TAGLINE=Computing. Creating. Leading.
COLLEGE_ADDRESS=Kimathi Street, Nairobi, Kenya
COLLEGE_PHONE=+254 700 123 456
COLLEGE_EMAIL=info@nayolites.ac.ke
COLLEGE_WEBSITE=www.nayolites.ac.ke
COLLEGE_CURRENCY=KES
COLLEGE_CURRENCY_SYMBOL=Ksh

# Local development uses SQLite. For PostgreSQL, set DB_ENGINE to
# django.db.backends.postgresql and provide DB_NAME, DB_USER, DB_PASSWORD,
# DB_HOST, and DB_PORT.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_SSLMODE=

# Optional SMTP email. The console backend prints emails in development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=webmaster@localhost

# Enable PayHero only after replacing these with live provider values.
PAYHERO_API_KEY=
PAYHERO_CHANNEL_ID=
PAYHERO_WEBHOOK_SECRET=
PAYHERO_CALLBACK_URL=

# Production security. Enable HSTS only after confirming HTTPS works.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TRUST_X_FORWARDED_PROTO=False
