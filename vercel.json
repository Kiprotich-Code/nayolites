{
  "builds": [
    {
      "src": "nayolites/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "templates/**",
          "static/**",
          "apps/**",
          "nayolites/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "nayolites/wsgi.py"
    }
  ]
}
